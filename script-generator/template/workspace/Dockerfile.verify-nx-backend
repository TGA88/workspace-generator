# Dockerfile.verify-nx-backend — node-app backend verification **(nx run-many variant)** · ในคอนเทนเนอร์
#   make verify-nx-backend  # หรือ: docker build -f workspaces/node-app/Dockerfile.verify-nx-backend workspaces/node-app
# ตรวจ backend ของ node-app: **libs + apps = lint(tsc+eslint) + unit test** โดยไม่ต้อง install อะไรลงเครื่อง
#   · apps unit test = jest coverage gate (webapi collectCoverageFrom=plugins/ · exclude app.ts/main.ts/telemetry.ts bootstrap) · integration จริงไป make api-test
#   · verify ด้วย **nx scripts ของ repo** (lint/test:backend-libs · lint/test:backend-apps) — ตรง pipeline จริงที่ใช้ nx
#     (ต่างจาก Dockerfile.verify-backend ที่ใช้ pnpm --filter แค่ **คำสั่ง verify** — ที่เหลือเหมือนกัน · default = pnpm variant)
#   · prisma client มากับ pnpm install (store-prisma postinstall) · build fail = lint/tsc/test พัง (เขียว = CMD echo ✅)
# ⚠️ verify image ของ **stack เดียว** (node-app) · workspace แบบ multi-stack (dotnet-app/springboot-app) แต่ละ stack มี verify ของตัวเอง (คนละ toolchain)
# ต่างจาก `make api-test` (black-box: compose ยก DB+API จริงแล้วยิง HTTP) — คนละ layer แต่ทั้งคู่ = local==CI
# build context = workspaces/node-app (reuse .dockerignore กัน host artifacts)
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates bash git \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable

WORKDIR /app
COPY . ./

RUN pnpm install --no-frozen-lockfile
# insurance เผื่อ data-store ที่ generate ไม่ผ่าน postinstall (--if-present = ข้าม package ที่ไม่มี script)
RUN pnpm -r --if-present run prisma:generate

# ---- verify ด้วย nx run-many (repo scripts): backend libs (lint+test) · backend apps (lint+test) ----
RUN NX_DAEMON=false pnpm run lint:backend-libs && NX_DAEMON=false pnpm run test:backend-libs
RUN NX_DAEMON=false pnpm run lint:backend-apps && NX_DAEMON=false pnpm run test:backend-apps

CMD ["echo", "✅ node-app backend: libs + apps lint+test passed (nx run-many)"]
