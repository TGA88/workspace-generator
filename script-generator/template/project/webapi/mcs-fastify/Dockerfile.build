# demo-exm-webapi — multi-stage build **(pnpm --filter variant · compose default)** · black-box api-test / ECR build
# build ในคอนเทนเนอร์ (source → dist) — เป็นตัว **default ของ docker-compose api** (robust สุด)
#   · ต่างจาก `Dockerfile` (runtime-only, CI `release`→`docker:build` COPY prebuilt dist) ที่ไม่ build ในคอนเทนเนอร์
#   · ต่างจาก `Dockerfile.nx-build` (nx run-many) แค่ **คำสั่ง build** — ที่เหลือเหมือนกัน
# build context = workspaces/node-app (ดู docker-compose api.build.context) · .dockerignore กัน host artifacts
# bookworm-slim (debian, openssl3) ให้ตรง prisma binaryTarget debian-openssl-3.0.x
#
# build ตาม **dependency graph** ด้วย pnpm: `--filter "<app>..."` = build app + dependencies (core/service/store-prisma)
#   ตาม topological order · store-prisma build รวม `prisma:generate` → prisma client มาพร้อม (ไม่ต้อง step แยก)
#   robust กว่า nx ในคอนเทนเนอร์ (ไม่พึ่ง nx project-graph ที่ target-defaults plugin เรียก `pnpm --version` แล้วล้ม)
#   · demo-exm-webapi-mcs-fastify = package name placeholder (new-webapi.sh sed `demo-exm-webapi` → service)

# ---------- build ----------
FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates bash git \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app

# copy ทั้ง workspace (source เท่านั้น — node_modules/dist/generated ถูก .dockerignore กันไว้)
COPY . .

RUN pnpm install --no-frozen-lockfile
# pnpm --filter "<app>..." = app + deps ตาม topological order (core/service/store-prisma) · store-prisma build → prisma:generate
RUN NX_DAEMON=false pnpm --filter "demo-exm-webapi-mcs-fastify..." run build

# ---------- runtime ----------
FROM node:22-bookworm-slim AS runtime
# openssl = prisma query engine ต้องใช้ (bookworm-slim ไม่มีมาให้) — ไม่งั้น engine mismatch (openssl 3.0.x)
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app
# copy ทั้ง tree ที่ build แล้ว (pnpm symlink node_modules + dist + generated engine คงโครง path เดียวกัน)
COPY --from=build /app /app
WORKDIR /app/apps/demo-exm-webapi/mcs-fastify

# fastify-cli รัน dist/src/app.js (ไม่ใช่ main.ts) · -a 0.0.0.0 ให้ reachable ผ่าน port map · PORT จาก env
EXPOSE 3000
CMD ["./node_modules/.bin/fastify", "start", "-a", "0.0.0.0", "-l", "info", "dist/src/app.js"]
