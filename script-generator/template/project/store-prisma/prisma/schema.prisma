// Prisma schema (base) — prisma v6
// เพิ่ม model ของ domain ด้วย `pnpm gen:api-wire ...` (หรือเพิ่มเอง) แล้วรัน:
//   pnpm prisma:generate && pnpm gen:up-script
generator client {
  // ---- prisma v6 ขึ้นไป (ค่าเริ่มต้นของ template) ----
  provider               = "prisma-client"
  output                 = "../generated/client"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  binaryTargets          = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x", "rhel-openssl-1.0.x", "linux-musl-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x"]

  // ---- prisma v5: เปิด comment ชุดนี้ + ปิดชุดบน + ใช้ build:prisma + dbclient import @prisma/<pkg>-client ----
  // provider      = "prisma-client-js"
  // output        = "../../../../../node_modules/@prisma/exm-data-client"
  // binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x", "rhel-openssl-1.0.x", "linux-musl-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ตัวอย่าง model (ลบ comment เพื่อใช้ หรือใช้ pnpm gen:api-wire สร้างให้):
// model Example {
//   id          String   @id @default(uuid())
//   name        String
//   createdAt   DateTime @default(now())
//   updatedAt   DateTime @updatedAt
//   @@map("example")
// }
